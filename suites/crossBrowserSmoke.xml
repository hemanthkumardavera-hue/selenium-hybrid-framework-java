<!DOCTYPE suite SYSTEM
"https://testng.org/testng-1.0.dtd">

<suite name="Cross Browser Suite">

    <test name="Chrome Test">

        <parameter name="browser"
                   value="chrome"/>

        <classes>
            <class name="com.qa.tests.LoginTest"/>
        </classes>

    </test>

    <test name="Edge Test">

        <parameter name="browser"
                   value="edge"/>

        <classes>
            <class name="com.qa.tests.LoginTest"/>
        </classes>

    </test>

</suite>