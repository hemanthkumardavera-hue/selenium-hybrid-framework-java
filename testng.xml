<suite
    name="Automation Suite"
    parallel="tests"
    thread-count="2">

    <parameter
        name="browser"
        value="chrome"/>

    <test name="Login Tests">

        <classes>
            <class name="com.qa.tests.LoginTest"/>
        </classes>

    </test>

    <test name="Logout Tests">

        <classes>
            <class name="com.qa.tests.LogoutTest"/>
        </classes>

    </test>

</suite>